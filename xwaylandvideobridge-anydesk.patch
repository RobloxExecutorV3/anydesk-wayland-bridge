--- a/src/xwaylandvideobridge.cpp
+++ b/src/xwaylandvideobridge.cpp
@@ -104,6 +104,12 @@
     m_sni->setStatus(KStatusNotifierItem::Passive);
 
     m_window->show();
+
+    // AnyDesk Wayland Bridge mode: start the portal stream immediately.
+    // The stock app waits until another X11 app redirects this window via XComposite.
+    if (qEnvironmentVariableIntValue("ANYDESK_WAYLAND_BRIDGE") == 1) {
+        QTimer::singleShot(100, this, [this]() { init(); });
+    }
 }
 
